PORT=8787
DATABASE_URL=

# APILayer integrations (keep keys server-side; add matching GitHub Actions/server secrets)
IPSTACK_API_KEY=
AVIATIONSTACK_API_KEY=
COUNTRYLAYER_API_KEY=
POSITIONSTACK_API_KEY=

# Live feeds (all optional — UI degrades gracefully when missing)
GTFS_REALTIME_URLS=
GTFS_POLL_INTERVAL_MS=15000
DELHI_OTD_API_KEY=
TRANSITOUS_COUNTRIES=all

AIS_API_URL=
# aisstream.io -> account -> API key. Live ship positions (AIS) over a websocket.
AISSTREAM_API_KEY=
TAXI_GEOJSON_URL=
TRAFFIC_GEOJSON_URL=
CAMERA_GEOJSON_URLS=
# opencellid.org -> account -> API access token. Cell tower locations.
OPENCELLID_API_KEY=
# mobilitydatabase.org -> account -> API access -> REFRESH token. Finds open GTFS-Realtime bus/rail feeds worldwide.
MOBILITY_DB_REFRESH_TOKEN=
MOBILITY_DB_MAX_FEEDS=150
# Optional dedicated railway GTFS-Realtime feeds; comma-separated. Add operator/global rail feeds when licensed/API access is available.
RAIL_GTFS_RT_URLS=
RAILWAY_API_URL=
RAILWAY_API_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional rewarded video
APPLIXIR_API_KEY=

# TrackMeNow admin audit (keep this secret; never put it in frontend code)
TRACKMENOW_ADMIN_TOKEN=
TRACKMENOW_AUDIT_LOG=./server/data/visitor-logs.jsonl

# WebRTC TURN relay. STUN is available by default; TURN is recommended for restrictive NAT/firewalls.
TURN_URLS=turn:your-turn-host:3478
TURN_USERNAME=
TURN_CREDENTIAL=
